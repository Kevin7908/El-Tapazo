# Copiar a .env  ->  cp .env.example .env
# Este archivo NO debe subirse a git.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Base de datos (deben coincidir con el servicio db del compose)
POSTGRES_DB=el_tapaso
POSTGRES_USER=el_tapaso
POSTGRES_PASSWORD=el_tapaso
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend autorizado a consumir la API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Correo saliente (invitaciones, recuperación de contraseña y verificación)
#
# NO TIENES QUE TOCAR NADA DE AQUÍ. Por defecto el correo va a Mailpit, una
# bandeja de entrada de mentira que corre en tu máquina: ./dev.sh correos
#
# Solo rellena esto si necesitas comprobar la entrega REAL (que llegue a la
# bandeja de alguien y no a spam). Descomenta las líneas de abajo con las
# credenciales SMTP de tu proveedor.
#
#   Brevo   -> smtp-relay.sendinblue.com   puerto 587  (300 correos/día gratis)
#             OJO: el panel dice smtp-relay.brevo.com, pero el nodo que
#             atiende Sudamérica sirve un certificado emitido solo para el
#             nombre viejo (sendinblue.com) y con el nuevo falla el TLS.
#             Mismo servidor, misma clave.
#   Resend  -> smtp.resend.com        puerto 587   (usuario: "resend")
#
# La contraseña SMTP es un secreto: va aquí y en el gestor de contraseñas,
# en ningún otro sitio. El .env NO se sube a git.
# ---------------------------------------------------------------------------
# Déjalas comentadas y el correo irá a Mailpit: ./dev.sh correos
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.sendinblue.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=El Tapaso <no-responder@el-tapaso.com>

# ---------------------------------------------------------------------------
# Enlaces que se mandan por correo
#
# Los abre el frontend, no el backend: esta es la base de las URLs
# /invitacion, /nueva-contrasena y /verificar-correo.
# ---------------------------------------------------------------------------
URL_FRONTEND=http://localhost:5173

# Vigencia de los enlaces y de las invitaciones
VIGENCIA_ENLACES_HORAS=24
VIGENCIA_INVITACION_DIAS=7

# Sesión (JSON Web Tokens)
MINUTOS_TOKEN_ACCESO=15
DIAS_TOKEN_REFRESCO=7

# Freno a la fuerza bruta en los endpoints públicos
LIMITE_INICIO_SESION=10/min
LIMITE_CORREOS_SALIENTES=5/hour
