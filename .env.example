# Variables que lee Docker Compose.
# Copiar a .env  ->  cp .env.example .env      (el .env NO se sube a git)

# ---------------------------------------------------------------------------
# ¿Dónde vive la base de datos?
#   local-db  -> contenedor de PostgreSQL en tu máquina (por defecto)
#   (vacío)   -> Supabase u otro Postgres remoto: rellena el bloque de abajo
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=local-db

# --- Base de datos LOCAL (solo aplica con COMPOSE_PROFILES=local-db) ---
POSTGRES_DB=el_tapaso
POSTGRES_USER=el_tapaso
POSTGRES_PASSWORD=el_tapaso
POSTGRES_PORT_HOST=5432        # puerto en TU máquina; ./dev.sh lo cambia si está ocupado

# --- Base de datos REMOTA (Supabase) ---
# Se toman de: Supabase -> Settings -> Database -> Connection string -> Session pooler
# Deja COMPOSE_PROFILES vacío y descomenta estas cuatro líneas.
# POSTGRES_HOST=aws-1-us-east-2.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres.tu_referencia_de_proyecto
# POSTGRES_PASSWORD=la-contrasena-de-tu-base-de-datos
# POSTGRES_DB=postgres

# --- Backend ---
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="El Tapaso"
