# Variables que lee Docker Compose.
# Copiar a .env  ->  cp .env.example .env      (el .env NO se sube a git)

# ---------------------------------------------------------------------------
# ¿Dónde vive la base de datos?
#   local-db  -> contenedor de PostgreSQL en tu máquina (por defecto)
#   (vacío)   -> Supabase u otro Postgres remoto: rellena el bloque de abajo
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=local-db

# --- Base de datos LOCAL (solo aplica con COMPOSE_PROFILES=local-db) ---
POSTGRES_DB=el_tapaso
POSTGRES_USER=el_tapaso
POSTGRES_PASSWORD=el_tapaso
POSTGRES_PORT_HOST=5432        # puerto en TU máquina; ./dev.sh lo cambia si está ocupado

# --- Base de datos REMOTA (Supabase) ---
# Se toman de: Supabase -> Settings -> Database -> Connection string -> Session pooler
# Deja COMPOSE_PROFILES vacío y descomenta estas cuatro líneas.
# POSTGRES_HOST=aws-1-us-east-2.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres.tu_referencia_de_proyecto
# POSTGRES_PASSWORD=la-contrasena-de-tu-base-de-datos
# POSTGRES_DB=postgres

# --- Backend ---
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="El Tapaso"

# ---------------------------------------------------------------------------
# Correo saliente (invitaciones, recuperación de contraseña y verificación)
#
# En desarrollo el correo se imprime en los logs del backend y no hace falta
# nada más. Para enviarlo de verdad, pon aquí las credenciales SMTP de tu
# proveedor (Brevo, Resend, Gmail…) y descomenta EMAIL_BACKEND.
#
#   Brevo   -> smtp-relay.brevo.com   puerto 587   (300 correos/día gratis)
#   Resend  -> smtp.resend.com        puerto 587   (usuario: "resend")
#
# La contraseña SMTP es un secreto: va aquí y en el gestor de contraseñas,
# en ningún otro sitio. El .env NO se sube a git.
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=El Tapaso <no-responder@el-tapaso.com>

# ---------------------------------------------------------------------------
# Enlaces que se mandan por correo
#
# Los abre el frontend, no el backend: esta es la base de las URLs
# /invitacion, /nueva-contrasena y /verificar-correo.
# ---------------------------------------------------------------------------
URL_FRONTEND=http://localhost:5173

# Vigencia de los enlaces y de las invitaciones
VIGENCIA_ENLACES_HORAS=24
VIGENCIA_INVITACION_DIAS=7

# Sesión (JSON Web Tokens)
MINUTOS_TOKEN_ACCESO=15
DIAS_TOKEN_REFRESCO=7

# Freno a la fuerza bruta en los endpoints públicos
LIMITE_INICIO_SESION=10/min
LIMITE_CORREOS_SALIENTES=5/hour
