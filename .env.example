# Variables que lee Docker Compose.
# Copiar a .env  ->  cp .env.example .env      (el .env NO se sube a git)

# --- Base de datos ---
POSTGRES_DB=el_tapaso
POSTGRES_USER=el_tapaso
POSTGRES_PASSWORD=el_tapaso
POSTGRES_PORT_HOST=5432        # puerto en TU máquina (cámbialo si ya usas el 5432)

# --- Backend ---
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=El Tapaso
